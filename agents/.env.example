# Copy to agents/.env and fill in. Never commit agents/.env.

# Required: OpenRouter (or compatible) API key
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Default / per-provider model slugs (examples — pin versions used in your run)
OPENROUTER_MODEL=qwen/qwen3.6-plus
OPENROUTER_MODEL_OPENAI=openai/gpt-5.5
OPENROUTER_MODEL_GOOGLE=google/gemini-3.1-pro-preview
OPENROUTER_MODEL_CLAUDE=anthropic/claude-opus-4.8

# Routing / orchestration
LLM_ROUTING=openrouter
MULTI_LLM_AGENT_MODE=full
REFACTOR_ORCHESTRATOR=langgraph

# RippleREF generation limits (match published protocol unless you intentionally ablate)
RIPPLE_REF_MAX_OUTPUT_TOKENS=2500

# Optional: backend base URL if agents call the local API
# REFACTAI_API_BASE=http://localhost:8080
